<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Exposure Scanner" Width="1080" Height="740" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                        GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= sidebar ================= -->
    <Border Background="{StaticResource Side}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,16,0">
          <Image Source="{StaticResource Logo}" Width="34" Height="34"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Exposure" Foreground="White" FontSize="15.5" FontWeight="SemiBold"
                       FontFamily="{StaticResource TitleFont}" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
            <TextBlock Text="Scanner" Foreground="#A5B4FC" FontSize="15.5" FontWeight="SemiBold"
                       FontFamily="{StaticResource TitleFont}" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,22">
          <Border Background="#111A2E" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Read-only checks" Foreground="#E2E8F0" FontSize="12.5" FontWeight="SemiBold"/>
              <TextBlock Foreground="{StaticResource SideText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17"
                         Text="Never logs in, attacks or changes anything. Only check sites you have permission for."/>
            </StackPanel>
          </Border>
          <Button x:Name="UpdateButton" Style="{StaticResource SidePill}" Background="#4F46E5" Foreground="White"
                  Margin="0,0,0,8" Visibility="Collapsed" ToolTip="Opens the download page">
            <TextBlock x:Name="UpdateText" Text="Update available"/>
          </Button>
          <Button x:Name="CoffeeButton" Style="{StaticResource SidePill}" Margin="0,0,0,14"
                  ToolTip="Exposure Scanner is free. A coffee helps keep it updated.">
            <StackPanel Orientation="Horizontal">
              <Path Data="M3,8 L15,8 L14,17 C13.8,18.7 12.6,20 11,20 L7,20 C5.4,20 4.2,18.7 4,17 Z M15,10 L17,10 C18.6,10 19.5,11.2 19.2,12.6 C18.9,14 17.7,15 16.3,15 L14.6,15 M7,3 L7,5.5 M11,3 L11,5.5"
                    Stroke="#0F172A" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Buy me a coffee" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="VersionText" Foreground="#475569" FontSize="12" Text="Version"/>
        </StackPanel>

        <StackPanel Margin="14,30,14,0">
          <TextBlock Text="MENU" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,8"/>
          <RadioButton x:Name="NavCheck" Style="{StaticResource NavButton}" IsChecked="True">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource NavIcon}" Data="M12,3 L20,6 L20,12 C20,16.5 16.5,19.6 12,21 C7.5,19.6 4,16.5 4,12 L4,6 Z M9,12 L11,14 L15,10"/>
              <TextBlock Text="New check-up" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource NavIcon}" Data="M7,3 L14,3 L19,8 L19,21 L7,21 Z M14,3 L14,8 L19,8 M10,13 L16,13 M10,17 L16,17"/>
              <TextBlock Text="Reports" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavHelp" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource NavIcon}" Data="M12,3 A9,9 0 1 1 11.99,3 Z M9.6,9.4 A2.5,2.5 0 1 1 12,12 L12,13.6 M12,17 L12,17.1"/>
              <TextBlock Text="How it works" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= main area ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- caption bar -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" ToolTip="Minimize">
          <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" ToolTip="Maximize">
          <Path x:Name="MaxGlyph" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
      </StackPanel>

      <!-- ===== page: new check-up ===== -->
      <ScrollViewer x:Name="PageCheck" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="56,6,56,48" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="New check-up" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}"
                     Text="Check a website's security settings and certificate, or scan a code folder for leaked passwords and keys. You get a plain-language report you can send."/>

          <Border Background="#ECEEF5" CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,26,0,18">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ModeSite" Style="{StaticResource SegButton}" Content="Website" IsChecked="True"/>
              <RadioButton x:Name="ModeFolder" Style="{StaticResource SegButton}" Content="Code folder"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}" Width="600" HorizontalAlignment="Left">
            <Grid>
              <!-- form -->
              <StackPanel x:Name="FormPanel">
                <StackPanel x:Name="SiteFields">
                  <TextBlock Text="Website address" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="SiteBox" Style="{StaticResource Field}" Tag="shop.com"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Just the address, like shop.com. Links with https:// are fine too."/>
                </StackPanel>

                <StackPanel x:Name="FolderFields" Visibility="Collapsed">
                  <TextBlock Text="Folder to scan" Style="{StaticResource FieldLabel}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource Field}" Tag="C:\code\my-project"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse..." Margin="10,0,0,0"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Hint}" Text="Looks for passwords, keys and tokens left in files, and for known malicious Python packages."/>
                </StackPanel>

                <Grid Margin="0,22,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="ClientLabel" Text="Client name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ClientBox" Style="{StaticResource Field}" Tag="Rosa's Bakery"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Your name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ByBox" Style="{StaticResource Field}" Tag="Shown as &quot;Prepared by&quot;"/>
                  </StackPanel>
                </Grid>

                <Border x:Name="NortonTip" Background="{StaticResource RecBg}" BorderBrush="{StaticResource RecLine}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,24,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M12,3 L22,20 L2,20 Z M12,9.5 L12,14 M12,17 L12,17.1" Stroke="{StaticResource RecFg}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"
                          VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock Grid.Column="1" FontSize="13" Foreground="#92400E" TextWrapping="Wrap" LineHeight="19">
                      <Run FontWeight="SemiBold" Text="Pause HTTPS scanning in your antivirus first."/>
                      <Run Text="Otherwise it replaces the site's certificate and that part of the report stays empty. In Norton: Security, Advanced Security, Web, Safe Web, Settings, HTTPS scanning."/>
                    </TextBlock>
                  </Grid>
                </Border>

                <CheckBox x:Name="PermBox" Style="{StaticResource Check}" Margin="0,22,0,0">
                  <TextBlock x:Name="PermText" TextWrapping="Wrap" Text="The owner of this website has signed the permission form."/>
                </CheckBox>

                <TextBlock x:Name="FormError" Foreground="{StaticResource ImpFg}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                  <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Run check-up"/>
                      <Path Data="M0,0 L5,5 L0,10" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            StrokeLineJoin="Round" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <TextBlock x:Name="RunHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="16,0,0,0"
                             Text="Fill in the address and tick the permission box."/>
                </StackPanel>
              </StackPanel>

              <!-- running -->
              <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Margin="0,8,0,8">
                <Image Source="{StaticResource Logo}" Width="44" Height="44" HorizontalAlignment="Left"/>
                <TextBlock x:Name="RunningTitle" Text="Checking shop.com" FontFamily="{StaticResource TitleFont}" FontSize="22"
                           FontWeight="SemiBold" Margin="0,18,0,0"/>
                <TextBlock x:Name="RunningSub" Style="{StaticResource PageSub}"
                           Text="This takes a few seconds. Nothing on the site is changed."/>
                <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Margin="0,26,0,0"/>
                <TextBlock x:Name="RunningStep" Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Connecting..."/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== page: result ===== -->
      <ScrollViewer x:Name="PageResult" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="56,6,56,48" MaxWidth="820" HorizontalAlignment="Left">
          <Button x:Name="BackButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Path Data="M5,0 L0,5 L5,10" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="New check-up"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="ResultTitle" Style="{StaticResource PageTitle}" Margin="0,14,0,0" Text="shop.com"/>
          <TextBlock x:Name="ResultSub" Style="{StaticResource PageSub}" Text="Client - date"/>

          <!-- ready / not ready -->
          <Border x:Name="ReadyBanner" CornerRadius="12" BorderThickness="1" Padding="18,14" Margin="0,22,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="ReadyDot" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top">
                <Path x:Name="ReadyGlyph" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="ReadyTitle" FontSize="15" FontWeight="SemiBold" Text="Ready to send"/>
                <TextBlock x:Name="ReadyText" FontSize="13.5" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="20"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock x:Name="VerdictText" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="2,28,0,14" Text="Verdict"/>

          <UniformGrid Columns="4" Margin="-6,0,-6,0">
            <Border Style="{StaticResource CardBox}" Padding="18,16" Margin="6">
              <StackPanel>
                <TextBlock x:Name="CountImp" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource ImpFg}" FontFamily="{StaticResource TitleFont}"/>
                <TextBlock Text="Important" Foreground="{StaticResource Muted}" FontSize="13"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Padding="18,16" Margin="6">
              <StackPanel>
                <TextBlock x:Name="CountRec" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RecFg}" FontFamily="{StaticResource TitleFont}"/>
                <TextBlock Text="Recommended" Foreground="{StaticResource Muted}" FontSize="13"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Padding="18,16" Margin="6">
              <StackPanel>
                <TextBlock x:Name="CountTip" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TipFg}" FontFamily="{StaticResource TitleFont}"/>
                <TextBlock Text="Tips" Foreground="{StaticResource Muted}" FontSize="13"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Padding="18,16" Margin="6">
              <StackPanel>
                <TextBlock x:Name="CountOk" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource OkFg}" FontFamily="{StaticResource TitleFont}"/>
                <TextBlock Text="Passed" Foreground="{StaticResource Muted}" FontSize="13"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <WrapPanel Margin="0,22,0,0">
            <Button x:Name="OpenReportButton" Style="{StaticResource PrimaryButton}" Content="Open report" Margin="0,0,10,10"/>
            <Button x:Name="PdfButton" Style="{StaticResource SecondaryButton}" Content="Save as PDF" Margin="0,0,10,10"/>
            <Button x:Name="ShowFolderButton" Style="{StaticResource SecondaryButton}" Content="Show in folder" Margin="0,0,10,10"/>
          </WrapPanel>
          <TextBlock x:Name="PdfStatus" Style="{StaticResource Hint}" Margin="2,0,0,0" Visibility="Collapsed"/>

          <TextBlock Text="What to fix" Style="{StaticResource SectionTitle}" Margin="2,26,0,12"/>
          <ItemsControl x:Name="IssuesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                        Padding="18,15" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding Fg}" CornerRadius="2" Margin="0,2"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding Bg}" CornerRadius="10" Padding="9,2">
                          <TextBlock Text="{Binding Level}" Foreground="{Binding Fg}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Site}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      <TextBlock Text="{Binding Fix}" Style="{StaticResource Body}" FontSize="13.5" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}"
                                 TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="NothingToFix" Style="{StaticResource CardBox}" Padding="22" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource OkFg}">
                <Path Data="M0,4 L3.5,7.5 L10,0" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Nothing to fix in the checks that were run." FontSize="14.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== page: reports ===== -->
      <ScrollViewer x:Name="PageReports" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="56,6,56,48" MaxWidth="820" HorizontalAlignment="Left">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Reports" Style="{StaticResource PageTitle}"/>
              <TextBlock x:Name="ReportsSub" Style="{StaticResource PageSub}" Text="Saved in Documents"/>
            </StackPanel>
            <Button x:Name="OpenReportsFolder" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open folder" VerticalAlignment="Center"/>
          </Grid>
          <ItemsControl x:Name="ReportsList" Margin="0,24,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                        Padding="16,12" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoft}">
                      <Path Data="M7,3 L14,3 L19,8 L19,21 L7,21 Z M14,3 L14,8 L19,8 M10,13 L16,13 M10,17 L16,17" Stroke="{StaticResource Accent}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Info}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource GhostButton}" Content="Open" Tag="{Binding Path}" x:Name="RowOpen"/>
                      <Button Style="{StaticResource GhostButton}" Content="PDF" Tag="{Binding Path}" x:Name="RowPdf"/>
                      <Button Style="{StaticResource GhostButton}" Content="Folder" Tag="{Binding Path}" x:Name="RowFolder"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="NoReports" Style="{StaticResource CardBox}" Margin="0,24,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="No reports yet" Style="{StaticResource SectionTitle}"/>
              <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="Run a check-up and its report shows up here."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== page: how it works ===== -->
      <ScrollViewer x:Name="PageHelp" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="56,6,56,48" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="How it works" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" Text="A check-up in five steps."/>

          <Border Style="{StaticResource CardBox}" Margin="0,24,0,0">
            <StackPanel x:Name="StepsPanel"/>
          </Border>

          <TextBlock Text="What gets checked" Style="{StaticResource SectionTitle}" Margin="2,30,0,12"/>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource Body}" Text="Websites: whether visitors are sent to https, the security settings sent with each page, software versions the server reveals, and the certificate (trust, expiry, key strength, encryption version)."/>
              <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="Code folders: passwords, keys and tokens left in files, and Python packages with known malicious versions."/>
              <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Foreground="{StaticResource Muted}" Text="Not covered: pages behind a login, break-in attempts, software the server does not announce, live certificate revocation. A clean report is not a guarantee."/>
            </StackPanel>
          </Border>

          <TextBlock Text="Command line" Style="{StaticResource SectionTitle}" Margin="2,30,0,12"/>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource Body}" Text="The installer adds the scanner command to your terminal. Open a new Command Prompt or PowerShell window and try:"/>
              <Border Background="#0F172A" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                <TextBlock x:Name="CliExamples" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="#E2E8F0" LineHeight="22"/>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="Free and open source" Style="{StaticResource SectionTitle}" Margin="2,30,0,12"/>
          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource Body}"
                         Text="Exposure Scanner is free under the MIT license. The source code, a permission form you can copy, and new versions are on GitHub. If it saves you time, you can buy the author a coffee."/>
              <WrapPanel Margin="0,16,0,0">
                <Button x:Name="FormButton" Style="{StaticResource PrimaryButton}" Content="Permission form template" Margin="0,0,10,10"/>
                <Button x:Name="RepoButton" Style="{StaticResource SecondaryButton}" Content="Open on GitHub" Margin="0,0,10,10"/>
                <Button x:Name="CoffeeButton2" Style="{StaticResource SecondaryButton}" Content="Buy me a coffee" Margin="0,0,10,10"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" Margin="2,24,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
