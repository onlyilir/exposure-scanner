<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Exposure Scanner Setup" Width="620" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="0"
                        GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="150"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header band -->
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0B1120" Offset="0"/>
          <GradientStop Color="#1E1B4B" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Button x:Name="CloseX" Style="{StaticResource CloseButton}" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,10,40,0">
          <Image Source="{StaticResource Logo}" Width="64" Height="64"/>
          <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="HeadTitle" Text="Install Exposure Scanner" Foreground="White" FontSize="24" FontWeight="SemiBold"
                       FontFamily="{StaticResource TitleFont}"/>
            <TextBlock x:Name="HeadSub" Text="Version" Foreground="#A5B4FC" FontSize="13.5" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="40,28,40,30">
      <!-- step 1: options -->
      <DockPanel x:Name="StepOptions">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,10,0"/>
          <Button x:Name="GoButton" Style="{StaticResource PrimaryButton}" Content="Install"/>
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="IntroText" Style="{StaticResource Body}"
                     Text="Checks websites and code folders for security problems and writes plain-language reports. Installs for your Windows account only, so no administrator rights are needed."/>
          <TextBlock Text="Install location" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" x:Name="LocationLabel"/>
          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="12,9" x:Name="LocationBox">
            <TextBlock x:Name="LocationText" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource Ink2}" TextTrimming="CharacterEllipsis"/>
          </Border>
          <StackPanel x:Name="OptionsPanel" Margin="0,18,0,0">
            <CheckBox x:Name="OptDesktop" Style="{StaticResource Check}" IsChecked="True" Content="Add a desktop shortcut"/>
            <CheckBox x:Name="OptPath" Style="{StaticResource Check}" IsChecked="True" Margin="0,12,0,0">
              <TextBlock TextWrapping="Wrap"><Run Text="Add the "/><Run FontFamily="{StaticResource MonoFont}" Text="scanner"/><Run Text=" command to Command Prompt and PowerShell"/></TextBlock>
            </CheckBox>
          </StackPanel>
          <TextBlock x:Name="ErrorText" Foreground="{StaticResource ImpFg}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </DockPanel>

      <!-- step 2: working -->
      <StackPanel x:Name="StepWork" Visibility="Collapsed" VerticalAlignment="Center">
        <TextBlock x:Name="WorkTitle" Text="Installing..." FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"/>
        <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Margin="0,18,0,0"/>
        <TextBlock x:Name="WorkStep" Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Copying files"/>
      </StackPanel>

      <!-- step 3: done -->
      <DockPanel x:Name="StepDone" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DoneClose" Style="{StaticResource SecondaryButton}" Content="Close" Margin="0,0,10,0"/>
          <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Content="Open Exposure Scanner"/>
        </StackPanel>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource OkFg}">
              <Path Data="M0,5 L4.5,9.5 L13,0" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="DoneTitle" Text="Installed" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,16,0,0"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
